# =============================================================
# Tamil Nadu Land Verification App — Environment Variables
# Copy to .env and fill in actual values
# =============================================================

# ---- Database ----
DB_PASSWORD=tnland_secret
DATABASE_URL=postgresql://tnland:tnland_secret@localhost:5432/tnland

# ---- Redis ----
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ---- Auth ----
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ---- AWS S3 ----
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=tn-land-verification-docs
AWS_REGION=ap-south-1

# ---- App ----
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ---- Automation ----
PLAYWRIGHT_HEADLESS=true
MAX_AUTOMATION_JOBS_PER_USER=5
AUTOMATION_JOB_TIMEOUT_MS=120000

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
