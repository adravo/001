# Required: powers the grounded, spoken answers.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional: OpenAI embeddings for retrieval quality. Without this, a
# deterministic local hashing fallback is used (fine for demos, not for
# production-quality retrieval).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: server-side TTS so the avatar lip-syncs to real generated audio.
# If neither is set, the frontend falls back to the browser's built-in
# SpeechSynthesis voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

AZURE_TTS_KEY=
AZURE_TTS_REGION=
AZURE_TTS_VOICE=en-US-JennyNeural

PORT=4000
RAG_TOP_K=4

# Where per-tenant document/embedding JSON snapshots are persisted.
DATA_DIR=./data
